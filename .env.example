# Copy to .env (cp .env.example .env). docker compose reads it automatically.
# Every value is optional; the defaults below match what compose uses without a .env.

# Host address the web UI is published on. 0.0.0.0 means every interface (LAN and tailnet).
# Set it to this machine's Tailscale IP (tailscale ip -4, a 100.x.y.z address) to keep the
# app off the LAN. That address must exist when the container starts, so if Docker comes
# up before Tailscale after a reboot, run docker compose up -d again.
ELO_BIND=0.0.0.0

# Host port for the web UI.
ELO_PORT=3000

# Only used by the optional sidecar: docker compose --profile tailscale up -d --build
# Auth key from https://login.tailscale.com/admin/settings/keys. Leave it empty to log in
# with the URL printed by: docker compose logs tailscale
TS_AUTHKEY=
# Machine name on the tailnet. The app is served at https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=elo
